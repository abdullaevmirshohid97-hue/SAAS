# =============================================================================
# Clary voice-agent (.env) — Asterisk serverida: /opt/clary/apps/voice-agent/.env
# =============================================================================

# Clary API (AI miyasi shu yerda). API .env.local dagi VOICE_AGENT_SECRET bilan BIR XIL.
VOICE_API_URL=https://api.clary.uz
VOICE_AGENT_SECRET=<openssl rand -hex 24>

# Asterisk AudioSocket() shu portga ulanadi (Asterisk shu serverda bo'lsa 127.0.0.1)
AUDIOSOCKET_HOST=127.0.0.1
AUDIOSOCKET_PORT=9092
# Dialplan CURL() uchun boshqaruv porti (faqat localhost!)
CONTROL_HOST=127.0.0.1
CONTROL_PORT=7071

# --- Nutq (faqat AI suhbat uchun; ATS va ovozli xabarga KERAK EMAS) ----------
# O'zimizning serverlar — bash infra/voice-models/install.sh o'zi to'ldiradi.
# Bo'sh qolsa: AI suhbat o'chiq, ATS'da hech kim olmasa ovozli xabar qoldiriladi.
# Nutq → matn: o'zimizning Whisper (infra/voice-models/stt_server.py)
STT_PROVIDER=openai
STT_OPENAI_URL=
STT_OPENAI_KEY=
STT_OPENAI_MODEL=whisper-1
# Birinchi gap o'zbek VA rus tilida tanib olinadi (AI tilni o'zi tanlaydi)
STT_DUAL_FIRST=true

# Matn → nutq: o'zimizning MMS-TTS (infra/voice-models/tts_server.py)
TTS_PROVIDER=http
TTS_HTTP_URL=
TTS_HTTP_KEY=
TTS_DEFAULT_VOICE=
TTS_CACHE_DIR=./var/tts-cache

# --- Suhbat ritmi ------------------------------------------------------------
# Shovqindan necha dB baland bo'lsa nutq (shovqinli liniyada 14–16)
VAD_START_DB=12
# Gap tugadi deyish uchun sukunat (ms). Kichik — tezroq javob, katta — bo'lmaydi
VAD_END_SILENCE_MS=700
VAD_MIN_SPEECH_MS=250
VAD_MAX_UTTERANCE_MS=15000
NO_INPUT_MS=7000
# Javob kechiksa "Bir daqiqa..." (ms)
FILLER_AFTER_MS=1300
VOICEMAIL_MAX_MS=60000

# --- Odamga ulash ------------------------------------------------------------
# Shlyuz/operator raqamni qanday kutadi: e164 (+998901234567) | digits12 (998901234567) | local9 (901234567)
TRANSFER_NUMBER_FORMAT=e164
# Bo'sh — qo'ng'iroq kelgan liniyadan (GoIP-1 bitta SIM'da ulash ISHLAMAYDI: liniya band).
# Masalan: goip2 yoki uztelecom
TRANSFER_ENDPOINT=

# Yozuvlarning lokal nusxasi (ixtiyoriy; asosiy nusxa — Supabase call-recordings)
RECORDINGS_DIR=
LOG_LEVEL=info

# --- Bulutli ATS (klinikalarning IP-telefoniyasi) — docs/ai-reception/05-bulut-ats.md
# true — Asterisk sozlamasi (pjsip_clary.conf, extensions_clary.conf) Clary API'dan
# avtomatik yoziladi; qo'ng'iroqlar jurnali va yozuvlar Clary'ga yuboriladi.
# install.sh PBX_DOMAIN bilan ishga tushirilsa o'zi yoqadi.
PBX_ENABLED=false
PBX_CONF_DIR=/etc/asterisk
PBX_SYNC_SEC=30
PBX_STATUS_SEC=30
# MixMonitor yozuvlari (Clary'ga yuklangach o'chiriladi; PBX_KEEP_RECORDINGS=true — saqlansin)
PBX_RECORDINGS_DIR=/var/spool/asterisk/monitor/clary
PBX_KEEP_RECORDINGS=false
PBX_TIMEZONE=Asia/Tashkent
ASTERISK_BIN=asterisk
