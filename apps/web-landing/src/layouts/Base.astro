---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import NavCin from '../components/cin/NavCin.astro';
import FooterCin from '../components/cin/FooterCin.astro';
import CinChrome from '../components/cin/CinChrome.astro';
import '../styles/cinematic.css';
import FloatingCta from '../components/FloatingCta.astro';
import Telemetry from '../components/Telemetry.astro';
import { ExitIntent } from '../components/ExitIntent';
import { CookieConsent } from '../components/CookieConsent';
import { buildHreflang, canonicalFor, isUntranslatedLocale } from '../lib/seo';

export interface Props {
  title?: string;
  description?: string;
  /** Qo'lda canonical kerak bo'lsa — aks holda yo'ldan avtomatik hisoblanadi. */
  canonical?: string;
  locale?: string;
  // `| undefined` ataylab: tsconfig'da exactOptionalPropertyTypes yoqilgan,
  // shusiz `image={post.image}` (string | undefined) uzatib bo'lmaydi.
  // Pastdagi destrukturizatsiyada default qiymat bor, ya'ni undefined uzatish
  // "rasm yo'q, defaultni ishlat" degani.
  image?: string | undefined;
  /** Sahifa breadcrumb zanjiri — BreadcrumbList JSON-LD uchun. */
  breadcrumbs?: Array<{ name: string; url: string }>;
  /** FAQ ro'yxati — FAQPage JSON-LD uchun (AI qidiruv va rich results). */
  faq?: Array<{ question: string; answer: string }>;
  /** true bo'lsa sahifa indekslanmaydi (signup, demo kabi). */
  noindex?: boolean;
  /** 'cinematic' — qorong'i "kino" dizayn (butun sayt, default). 'default' — eski yorug' dizayn. */
  variant?: 'default' | 'cinematic';
  /** Sarlavha hero ustida (bosh sahifa, tariflar) — aks holda oqimda turadi. */
  overlayNav?: boolean;
}

const {
  title = 'Clary — Healthcare ERP & Clinic Management System',
  description = 'Clary is a Healthcare ERP and clinic management system for clinics, hospitals, laboratories and pharmacies — reception, queue, cashier, lab (LIS), pharmacy, inpatient, dental, payroll and analytics in one platform.',
  canonical,
  locale = 'uz-Latn',
  image = '/og-default.png',
  breadcrumbs,
  faq,
  noindex = false,
  variant = 'cinematic',
  overlayNav = false,
} = Astro.props;

const year = new Date().getFullYear();

// Google Search Console tasdiqlash — meta `content` ga FAQAT token (prefiks
// `google-site-verification=` siz). Env override mumkin, aks holda default token.
const gscVerification =
  (import.meta.env.PUBLIC_GSC_VERIFICATION as string | undefined) ??
  '7C3w0NGXWHyR-Wy2dIfIb4ybMNXgZYJs6iMJ2pZd-LY';

// Canonical va hreflang — sahifa yo'lidan avtomatik (SEO xatosini tuzatadi).
const pathname = Astro.url.pathname;
const canonicalUrl = canonical ?? canonicalFor(pathname);
const hreflangLinks = buildHreflang(pathname);
// Tarjima qilinmagan til varianti (uz-Cyrl/kk/ky/tg) — sahifa ochiladi, lekin
// indekslanmaydi: aks holda bir xil o'zbekcha matn 5 xil URL'da dublikat bo'ladi.
const shouldNoindex = noindex || isUntranslatedLocale(pathname);
// og:image absolyut URL bo'lishi shart — Facebook/Telegram nisbiy yo'lni o'qimaydi.
const imageUrl = new URL(image, Astro.site ?? 'https://clary.uz').href;

// JSON-LD resurslar
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Clary',
  alternateName: 'Clary Healthcare ERP',
  slogan: 'Healthcare ERP platform for clinics & hospitals',
  description:
    'Clary is a Healthcare ERP and clinic management system for clinics, hospitals, laboratories, pharmacies and dental practices.',
  url: 'https://clary.uz',
  logo: 'https://clary.uz/icon-512.png',
  email: 'clarysupport@gmail.com',
  address: { '@type': 'PostalAddress', addressCountry: 'UZ', addressLocality: 'Tashkent' },
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Clary',
  url: 'https://clary.uz',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://clary.uz/blog?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Clary',
  alternateName: 'Clary Healthcare ERP',
  operatingSystem: 'Web, iOS, Android',
  applicationCategory: 'HealthApplication',
  applicationSubCategory: 'Healthcare ERP',
  keywords:
    'Healthcare ERP, clinic management system, hospital management software, LIS, pharmacy management, EMR, EHR',
  description,
  offers: [
    { '@type': 'Offer', price: '0', priceCurrency: 'UZS', name: 'Demo — 3 kun bepul' },
    { '@type': 'Offer', price: '300000', priceCurrency: 'UZS', name: 'Base' },
    { '@type': 'Offer', price: '600000', priceCurrency: 'UZS', name: 'Pro' },
    { '@type': 'Offer', price: '1500000', priceCurrency: 'UZS', name: 'Enterprise' },
  ],
};

const breadcrumbLd = breadcrumbs && breadcrumbs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: b.url,
      })),
    }
  : null;

const faqLd = faq && faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;
---
<!doctype html>
<html lang={locale} class={variant === 'cinematic' ? 'scroll-smooth dark' : 'scroll-smooth'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {shouldNoindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    <link rel="alternate" type="application/rss+xml" title="Clary Blog — Healthcare ERP" href="https://clary.uz/feed.xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2563EB" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Clary" />

    <!-- OpenGraph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={locale.replace('-', '_')} />
    <meta property="og:site_name" content="Clary" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- hreflang alternates — har sahifa o'zining locale variantlariga -->
    {hreflangLinks.map((l) => (
      <link rel="alternate" hreflang={l.hreflang} href={l.href} />
    ))}

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
    {breadcrumbLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    )}
    {faqLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    )}

    <Telemetry />
    {variant === 'cinematic' && (
      <>
        <meta name="theme-color" content="#0c0c0e" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@600&family=Roboto+Mono:wght@400;500;700&display=swap"
        />
        <script is:inline>
          (function () {
            var r = document.documentElement;
            r.classList.add('cin-js');
            try {
              var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
              if (!reduce && !sessionStorage.getItem('cin-seen')) r.classList.add('cin-loading');
            } catch (e) {}
          })();
        </script>
      </>
    )}
  </head>
  <body class={variant === 'cinematic' ? 'cin cin-grain min-h-screen antialiased' : 'min-h-screen font-sans antialiased'} id="top">
    {variant === 'cinematic' ? <NavCin overlay={overlayNav} /> : <Nav />}
    <slot />
    {variant !== 'cinematic' && <FloatingCta />}
    <ExitIntent client:idle />
    <CookieConsent client:idle />
    {variant === 'cinematic' ? <FooterCin year={year} /> : <Footer year={year} />}
    {variant === 'cinematic' && <CinChrome />}
  </body>
</html>
