---
import { SUPPORTED_LOCALES, LOCALE_LABELS, DEFAULT_LOCALE } from '../../lib/locales';

// Qorong'i "kino" sarlavha: logotip, holat pill, kirish va to'liq ekranli menyu.
export interface Props {
  /** true — hero ustida (absolute), false — oddiy oqimda */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const links = [
  { href: '/', label: 'Bosh sahifa' },
  { href: '/features', label: 'Imkoniyatlar' },
  { href: '/pricing', label: 'Tariflar' },
  { href: '/solutions', label: 'Yechimlar' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Aloqa' },
];
---
<header class={overlay ? 'absolute inset-x-0 top-0 z-[86]' : 'relative z-[86]'}>
  <div class="mx-auto flex max-w-[1440px] items-center gap-6 px-5 py-6 sm:px-10 lg:px-[90px] lg:py-10">
    <a href="/" class="flex items-center gap-3" data-cursor>
      <span class="cin-display flex h-12 w-12 items-center justify-center rounded-full bg-[var(--cin-cream)] pt-0.5 text-[26px] !text-[#111]">C</span>
      <span class="leading-tight">
        <span class="block text-[15px] font-bold text-white">Clary</span>
        <span class="cin-label block text-white/60">Healthcare ERP</span>
      </span>
    </a>
    <span class="ml-6 hidden md:block">
      <a href="/signup" class="cin-pill cin-pill--ghost" data-cursor>
        <span class="h-2 w-2 rounded-full bg-[#22c55e]"></span> 30 kun bepul sinov
      </a>
    </span>
    <nav class="ml-auto hidden items-center gap-7 text-[13px] text-white/80 lg:flex">
      <a href="/features" class="transition hover:text-white">Imkoniyatlar</a>
      <a href="/pricing" class="transition hover:text-white">Tariflar</a>
      <a href="/blog" class="transition hover:text-white">Blog</a>
      <a href="https://app.clary.uz/login" class="transition hover:text-white">Kirish</a>
    </nav>
    <button
      type="button"
      class="cin-burger ml-auto p-2 lg:ml-4"
      aria-label="Menyu"
      aria-expanded="false"
      aria-controls="cin-menu"
      data-cin-menu-toggle
      data-cursor
    >
      <span></span><span></span>
    </button>
  </div>
</header>

<div id="cin-menu" class="cin-menu" aria-hidden="true">
  <div class="mx-auto flex h-full max-w-[1440px] flex-col justify-between px-5 pb-10 pt-32 sm:px-10 lg:px-[90px]">
    <nav class="flex flex-col">
      {links.map((l, i) => (
        <a
          href={l.href}
          class="cin-display group flex items-baseline gap-4 py-1 text-[clamp(48px,9vw,128px)] transition-colors hover:text-white"
        >
          <span class="font-mono text-sm text-white/40">0{i + 1}</span>
          <span class="transition-transform duration-500 group-hover:translate-x-4">{l.label}</span>
        </a>
      ))}
    </nav>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-white/10 pt-6 text-sm text-white/70">
      <a href="https://app.clary.uz/login" class="hover:text-white">Kirish</a>
      <a href="/signup" class="hover:text-white">Ro'yxatdan o'tish</a>
      <a href="/download" class="hover:text-white">Ilovalar</a>
      <a href="mailto:clarysupport@gmail.com" class="hover:text-white">clarysupport@gmail.com</a>
      <span class="ml-auto flex flex-wrap gap-3">
        {SUPPORTED_LOCALES.map((loc) => (
          <a href={loc === DEFAULT_LOCALE ? '/' : `/${loc}/`} class="cin-label text-white/50 hover:text-white">
            {LOCALE_LABELS[loc]}
          </a>
        ))}
      </span>
    </div>
  </div>
</div>
