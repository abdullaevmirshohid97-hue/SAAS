---
const faqs = [
  {
    q: 'Necha kun bepul sinab ko\'rish mumkin?',
    a: 'Ro\'yxatdan o\'tganingizdan keyin 3 kunlik demo ochiladi. Shu vaqt ichida tarif tanlasangiz — 30 kun bepul sinov (bir marta). Bank kartasi so\'ralmaydi, kiritilgan ma\'lumotlar to\'lovdan keyin ham saqlanib qoladi.',
  },
  {
    q: 'Yashirin to\'lovlar bormi?',
    a: 'Yo\'q. Tarifda ko\'rsatilgan summa — siz to\'laydigan yagona summa. SMS va Click/Payme to\'lovlar uchun siz o\'z API kalitlaringizni ulaysiz, pullar to\'g\'ridan to\'g\'ri sizning bank hisobingizga tushadi.',
  },
  {
    q: 'Tarifni o\'zgartirish mumkinmi?',
    a: 'Ha, Sozlamalar > Obuna bo\'limida istalgan vaqt. Tarif o\'zgarganda ma\'lumotlar o\'chirilmaydi — yangi tarifga kirmaydigan bo\'lim faqat yopiladi va kengaytirilganda qaytadi.',
  },
  {
    q: 'Mening ma\'lumotlarim qayerda saqlanadi?',
    a: 'Xalqaro bulut infratuzilmasida (AWS) shifrlangan ulanish orqali. Har bir klinika ma\'lumoti qator darajasidagi xavfsizlik bilan boshqasidan ajratilgan, muntazam zaxira nusxalar olinadi. Rollar, qurilmalar nazorati va audit jurnali bor.',
  },
  {
    q: 'Excel\'dan ma\'lumotlarni ko\'chirish qiyinmi?',
    a: 'Yo\'q. Bemor bazasi va xizmatlar ro\'yxatini CSV orqali import qilamiz. Onboarding bosqichida bizning jamoa yordam beradi (Pro va Enterprise\'da bepul).',
  },
  {
    q: 'Click, Payme, Uzcard ulaymanmi?',
    a: 'Ha. Kassada naqd, karta (Humo, Uzcard), Click, Payme, Uzum va aralash to\'lov qabul qilinadi; Click va Payme QR to\'lovi o\'z merchant kalitlaringiz bilan ulanadi — pul to\'g\'ridan-to\'g\'ri klinikangiz hisobiga tushadi.',
  },
  {
    q: 'Xodimlarni o\'qitish qancha vaqt oladi?',
    a: 'Reception 1-2 soatda, shifokor 30 daqiqada o\'rganadi. Onboarding davomida video qo\'llanma va jonli demo (Pro va Enterprise\'da). Ko\'p klinikalar 1 hafta ichida to\'liq o\'tadi.',
  },
  {
    q: 'Agar yoqmasa nima bo\'ladi?',
    a: 'Istalgan vaqt bekor qiling — uzoq muddatli shartnoma yo\'q. Barcha ma\'lumotlaringizni CSV/JSON formatida eksport qilish mumkin (Settings → Eksport).',
  },
];
---

<section class="container mx-auto max-w-3xl px-4 py-20">
  <div class="text-center">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Ko'p beriladigan savollar</h2>
    <p class="mt-3 text-muted-foreground">Boshqa savol bormi? <a href="/contact" class="text-[#2563EB] hover:underline">Biz bilan bog'laning</a></p>
  </div>

  <div class="mt-10 space-y-3">
    {faqs.map((f) => (
      <details class="group rounded-lg border bg-card p-5">
        <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold sm:text-base">
          <span>{f.q}</span>
          <span class="ml-4 text-muted-foreground transition group-open:rotate-180">&#8964;</span>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{f.a}</p>
      </details>
    ))}
  </div>
</section>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  })}
/>
