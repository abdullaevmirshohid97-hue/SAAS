---
import Base from '../layouts/Base.astro';
import { fetchSiteContent, getSeoOverride, getString } from '../lib/cms';
import { fetchPublicPlans, FALLBACK_GROUPS, FALLBACK_MODULES, type PublicPlan } from '../lib/plans';
import { RoiCalculator } from '../components/RoiCalculator';
import ComparisonTable from '../components/ComparisonTable.astro';
import PricingFaq from '../components/PricingFaq.astro';
import { ModuleIcon } from '../components/ModuleIcon';
import { ArrowUpRight } from 'lucide-react';
import Marquee from '../components/cin/Marquee.astro';

interface Plan {
  code: string;
  name: string;
  description: string | null;
  monthly: number;
  annualMonthly: number;
  annualTotal: number;
  staff: string;
  devices: string;
  features: string[];
  modulesCount: number | null;
  featured?: boolean;
  badge?: string;
}

const cms = await fetchSiteContent('uz-Latn');
const seo = getSeoOverride(cms, '/pricing');
const pub = await fetchPublicPlans();

// Har bir tarifda doim bor asosiy bo'limlar (modul katalogiga kirmaydi)
const CORE_COUNT = 6;
const limitText = (n: number | null) => (n == null ? 'Cheksiz' : String(n));

// Asosiy manba — super-admin tarif muharriri (GET /public/plans). API javob
// bermasa — eski fallback + CMS'dagi plan.<code> narxi.
const fallbackPlans: Plan[] = [
  { code: 'demo', name: 'Demo', description: null, monthly: 0, annualMonthly: 0, annualTotal: 0, staff: '2', devices: '2', features: ['3 kunlik demo', "Karta so'ralmaydi", 'Asosiy modullar'], modulesCount: null, badge: 'Boshlash uchun' },
  { code: '25pro', name: 'Base', description: null, monthly: 300000, annualMonthly: 240000, annualTotal: 2880000, staff: '2', devices: '2', features: ['Qabulxona, navbat va kassa', 'Bemorlar bazasi', 'Dorixona', 'Click/Payme'], modulesCount: null },
  { code: '50pro', name: 'Pro', description: null, monthly: 600000, annualMonthly: 480000, annualTotal: 5760000, staff: '10', devices: '10', features: ['Base + hammasi', 'Diagnostika va laboratoriya', 'Kengaytirilgan analitika', 'Bepul onboarding'], modulesCount: null, featured: true, badge: "Ko'p tanlanadi" },
  { code: '120pro', name: 'Enterprise', description: null, monthly: 1500000, annualMonthly: 1200000, annualTotal: 14400000, staff: 'Cheksiz', devices: 'Cheksiz', features: ['Pro + hammasi', '10 tagacha filial', 'Maxsus rollar', 'Ustuvor yordam'], modulesCount: null },
];

const fromApi = (p: PublicPlan): Plan => {
  const monthly = p.price_uzs ?? 0;
  const annualTotal = p.price_yearly_uzs ?? Math.round(monthly * 12 * 0.8);
  return {
    code: p.code,
    name: p.name,
    description: p.description,
    monthly,
    annualTotal,
    annualMonthly: Math.round(annualTotal / 12),
    staff: limitText(p.limits.max_staff),
    devices: limitText(p.limits.max_devices),
    features: p.highlights,
    modulesCount: p.modules.length + CORE_COUNT,
  };
};

let plans: Plan[];
if (pub && pub.plans.length > 0) {
  plans = pub.plans.map(fromApi);
  const paid = plans.filter((p) => p.monthly > 0);
  const mid = paid[Math.floor((paid.length - 1) / 2)];
  if (mid && paid.length >= 3) {
    mid.featured = true;
    mid.badge = "Ko'p tanlanadi";
  }
  const demo = plans.find((p) => p.monthly === 0);
  if (demo) demo.badge = 'Boshlash uchun';
} else {
  plans = fallbackPlans.map((p) => {
    const e = cms?.by_key?.[`plan.${p.code}`];
    const uzs = typeof e?.data?.price_uzs === 'number' ? (e.data.price_uzs as number) : undefined;
    const monthly = uzs ?? p.monthly;
    return {
      ...p,
      name: getString(e, 'name', p.name),
      monthly,
      annualMonthly: Math.round(monthly * 0.8),
      annualTotal: Math.round(monthly * 12 * 0.8),
    };
  });
}

const groups = pub?.groups ?? FALLBACK_GROUPS;
const modules = pub?.modules ?? FALLBACK_MODULES;
const matrixPlans = pub?.plans ?? [];
const yearlyDiscount = (() => {
  const p = plans.find((x) => x.monthly > 0);
  if (!p || !p.monthly) return 20;
  return Math.max(0, Math.round((1 - p.annualTotal / (p.monthly * 12)) * 100));
})();

const W = 'mx-auto max-w-[1440px] px-5 sm:px-10 lg:px-[90px]';
const fmtUzs = (n: number) => Math.round(n).toLocaleString('ru-RU').replace(/[  ,]/g, ' ');
const methodLabel: Record<string, string> = {
  cash: 'Naqd', card: 'Karta', humo: 'Humo', uzcard: 'Uzcard', transfer: "O'tkazma",
  click: 'Click', payme: 'Payme', uzum: 'Uzum', mbank: 'Mbank', insurance: "Sug'urta", debt: 'Qarzga',
};
---

<Base
  variant="cinematic"
  overlayNav
  title={seo?.title ?? "Tariflar — Clary | Modullar, limitlar va narxlar so'mda"}
  description={seo?.description ?? "Clary tariflari: har bir tarifga qaysi modullar kirishi, xodim va qurilma limitlari, oylik va yillik narx so'mda. 30 kun bepul sinov, karta so'ralmaydi."}
  image={seo?.ogImage}
>
  <!-- Hero -->
  <section class={`${W} pb-6 pt-40 lg:pt-52`}>
    <h1 class="cin-display text-[clamp(72px,17vw,280px)]">
      <span class="cin-line"><span>Tariflar</span></span>
    </h1>
    <div class="mt-10 flex flex-col gap-8 border-t border-white/10 pt-8 lg:flex-row lg:items-center lg:justify-between" data-reveal>
      <p class="max-w-xl text-sm leading-relaxed text-white/70">
        Narxlar so'mda, yashirin to'lovsiz. Tarifni istalgan vaqt o'zgartirasiz — ma'lumotlar saqlanib qoladi. Klinikangizga alohida tarkib kerak bo'lsa, individual kelishuv tuzamiz.
      </p>
      <div id="billing-toggle" class="inline-flex self-start rounded-full border border-white/15 p-1">
        <button type="button" data-period="monthly" class="billing-btn cin-label rounded-full bg-[var(--cin-cream)] px-6 py-3 text-[#111] transition">Oylik</button>
        <button type="button" data-period="annual" class="billing-btn cin-label rounded-full px-6 py-3 text-white/70 transition hover:text-white">
          Yillik {yearlyDiscount > 0 && <span class="ml-1 opacity-70">−{yearlyDiscount}%</span>}
        </button>
      </div>
    </div>
  </section>

  <section class={`${W} pb-10`}>
    <div class={`grid grid-cols-1 gap-5 md:grid-cols-2 ${plans.length >= 4 ? 'xl:grid-cols-4' : 'lg:grid-cols-3'}`}>
      {plans.map((p, i) => (
        <div
          class={`relative flex flex-col rounded-[18px] p-7 ${p.featured ? 'bg-[var(--cin-cream)] text-[#111]' : 'bg-[var(--cin-card)] text-white'}`}
          data-plan={p.code}
          data-monthly={p.monthly}
          data-annual={p.annualMonthly}
          data-reveal
          data-reveal-delay={String(i % 4)}
        >
          <div class="flex flex-wrap items-center gap-2">
            {p.badge && <span class={`cin-pill ${p.featured ? '!bg-[#111] !text-white' : ''}`}>{p.badge}</span>}
            <span class={`cin-label ${p.featured ? 'text-black/55' : 'text-white/45'}`}>{p.staff} xodim · {p.devices} qurilma</span>
          </div>
          <h2 class={`cin-display mt-6 text-[clamp(48px,4.4vw,68px)] ${p.featured ? '!text-[#111]' : '!text-white'}`}>{p.name}</h2>
          {p.description && <p class="mt-2 text-sm opacity-70">{p.description}</p>}
          <div class="mt-6 flex items-baseline gap-1.5">
            <span class="price-display text-4xl font-bold tracking-tight">{fmtUzs(p.monthly)}</span>
            {p.monthly > 0 && <span class="text-sm opacity-60">so'm/oy</span>}
          </div>
          {p.monthly > 0 ? (
            <div class="annual-note mt-1 hidden text-xs opacity-60">Yiliga {fmtUzs(p.annualTotal)} so'm</div>
          ) : (
            <div class="mt-1 text-xs opacity-60">3 kunlik demo, keyin tarif tanlaysiz</div>
          )}
          <ul class="mt-7 flex-1 space-y-2.5 text-sm opacity-85">
            {p.modulesCount != null && <li>✳ {p.modulesCount} modul</li>}
            {p.features.map((f) => <li>✳ {f}</li>)}
          </ul>
          <a
            href={`/signup?plan=${p.code}`}
            class={`cin-btn mt-8 ${p.featured ? 'bg-[#111] text-white hover:bg-black' : 'cin-btn--solid'}`}
            data-magnetic
          >
            {p.monthly === 0 ? 'Bepul boshlash' : '30 kun bepul'} <ArrowUpRight className="h-4 w-4" />
          </a>
        </div>
      ))}
    </div>
    <p class="mt-6 text-center text-xs text-white/50">
      3 kunlik demo · tarif tanlasangiz 30 kun bepul · karta so'ralmaydi · Click, Payme yoki bank o'tkazmasi
    </p>
  </section>

  <!-- Taqqoslash matritsasi (super-admin tarif muharriridan) -->
  {matrixPlans.length > 0 && (
    <>
      <Marquee text="Taqqoslash" reverse speed={40} />
      <section class={`${W} pb-10`}>
        <div class="overflow-x-auto rounded-[18px] border border-white/10 bg-[var(--cin-card)]" data-reveal>
          <table class="w-full min-w-[760px] text-sm">
            <thead>
              <tr class="border-b border-white/10">
                <th class="cin-label px-5 py-4 text-left text-white/60">Imkoniyat</th>
                {matrixPlans.map((p) => <th class="cin-display px-3 py-4 text-center text-2xl !text-white">{p.name}</th>)}
              </tr>
            </thead>
            <tbody>
              <tr><td colspan={99} class="cin-label bg-white/[0.03] px-5 py-2.5 text-white/45">Limitlar</td></tr>
              <tr class="border-t border-white/5">
                <td class="px-5 py-3 text-white/80">Xodimlar</td>
                {matrixPlans.map((p) => <td class="px-3 py-3 text-center text-white">{limitText(p.limits.max_staff)}</td>)}
              </tr>
              <tr class="border-t border-white/5">
                <td class="px-5 py-3 text-white/80">Qurilmalar</td>
                {matrixPlans.map((p) => <td class="px-3 py-3 text-center text-white">{limitText(p.limits.max_devices)}</td>)}
              </tr>
              {groups.map((g) => {
                const list = modules.filter((m) => m.group === g.key);
                return list.length === 0 ? null : (
                  <>
                    <tr><td colspan={99} class="cin-label bg-white/[0.03] px-5 py-2.5 text-white/45">{g.label}</td></tr>
                    {list.map((m) => (
                      <tr class="border-t border-white/5">
                        <td class="px-5 py-3 text-white/80">
                          <span class="inline-flex items-center gap-2.5"><ModuleIcon name={m.key} className="h-4 w-4 text-white/40" /> {m.label}</span>
                        </td>
                        {matrixPlans.map((p) => (
                          <td class="px-3 py-3 text-center">
                            {p.modules.includes(m.key) ? <span class="text-[var(--cin-cream)]">✳</span> : <span class="text-white/20">—</span>}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </>
                );
              })}
              <tr><td colspan={99} class="cin-label bg-white/[0.03] px-5 py-2.5 text-white/45">Jurnal va to'lovlar</td></tr>
              <tr class="border-t border-white/5">
                <td class="px-5 py-3 text-white/80">To'lov turlari</td>
                {matrixPlans.map((p) => (
                  <td class="px-3 py-3 text-center text-xs text-white/80">
                    {p.payments.methods ? p.payments.methods.map((k) => methodLabel[k] ?? k).join(', ') : 'Hammasi'}
                  </td>
                ))}
              </tr>
              <tr class="border-t border-white/5">
                <td class="px-5 py-3 text-white/80">Jurnal tarixi</td>
                {matrixPlans.map((p) => <td class="px-3 py-3 text-center text-xs text-white/80">{p.journal.history_days ? `${p.journal.history_days} kun` : 'Cheksiz'}</td>)}
              </tr>
              {([
                ['Jurnalni tahrirlash', (p: PublicPlan) => p.journal.allow_edit],
                ["O'chirish / bekor qilish", (p: PublicPlan) => p.journal.allow_delete],
                ['Eksport (CSV)', (p: PublicPlan) => p.journal.allow_export],
                ['Maxsus rollar', (p: PublicPlan) => p.roles.custom_roles],
                ['Windows ilovasi', (p: PublicPlan) => p.devices.clients.desktop !== false],
                ['Mobil ilova', (p: PublicPlan) => p.devices.clients.mobile !== false],
              ] as Array<[string, (p: PublicPlan) => boolean]>).map(([label, fn]) => (
                <tr class="border-t border-white/5">
                  <td class="px-5 py-3 text-white/80">{label}</td>
                  {matrixPlans.map((p) => (
                    <td class="px-3 py-3 text-center">{fn(p) ? <span class="text-[var(--cin-cream)]">✳</span> : <span class="text-white/20">—</span>}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </>
  )}

  <!-- ROI kalkulyator -->
  <Marquee text="Hisob-kitob" speed={36} />
  <section class={`${W} pb-10`}>
    <p class="mb-8 max-w-xl text-sm text-white/65" data-reveal>Slayderlarni surib, klinikangiz uchun tejamni ko'ring.</p>
    <RoiCalculator client:visible />
  </section>

  <ComparisonTable />

  <PricingFaq />

  <section class={`${W} pb-24 pt-10`}>
    <div class="flex flex-col items-start justify-between gap-8 rounded-[18px] bg-[var(--cin-cream)] p-8 text-[#111] sm:p-12 lg:flex-row lg:items-center" data-reveal>
      <p class="cin-display text-[clamp(44px,5vw,80px)] !text-[#111]">Qaysi tarif mos?</p>
      <div class="flex flex-wrap gap-3">
        <a href="/signup" class="cin-btn bg-[#111] text-white hover:bg-black" data-magnetic>Bepul boshlash <ArrowUpRight className="h-4 w-4" /></a>
        <a href="/book-demo" class="cin-btn border border-black/30 hover:border-black" data-magnetic>Jonli namoyish</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.billing-btn');
  const cards = document.querySelectorAll<HTMLElement>('[data-plan]');
  const annualNotes = document.querySelectorAll<HTMLElement>('.annual-note');

  function setPeriod(period: string) {
    buttons.forEach((b) => {
      const active = b.dataset.period === period;
      b.classList.toggle('bg-[var(--cin-cream)]', active);
      b.classList.toggle('text-[#111]', active);
      b.classList.toggle('text-white/70', !active);
    });
    const fmt = (s: string) => Number(s || '0').toLocaleString('ru-RU').replace(/[  ,]/g, ' ');
    cards.forEach((c) => {
      const display = c.querySelector<HTMLElement>('.price-display');
      const monthly = c.dataset.monthly ?? '0';
      const annual = c.dataset.annual ?? '0';
      if (display) display.textContent = fmt(period === 'annual' ? annual : monthly);
    });
    annualNotes.forEach((n) => n.classList.toggle('hidden', period !== 'annual'));

    try {
      // @ts-ignore
      window.posthog?.capture?.('pricing_period_toggled', { period });
    } catch {}
  }

  buttons.forEach((b) => b.addEventListener('click', () => setPeriod(b.dataset.period ?? 'monthly')));
</script>
