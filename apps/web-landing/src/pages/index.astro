---
import Base from '../layouts/Base.astro';
import { fetchSiteContent, getSeoOverride, getString } from '../lib/cms';
import { FALLBACK_GROUPS, FALLBACK_MODULES, fetchPublicPlans, fmtUzs } from '../lib/plans';
import { ModuleIcon } from '../components/ModuleIcon';
import Marquee from '../components/cin/Marquee.astro';
import CinArt from '../components/cin/CinArt.astro';
import {
  ArrowDownRight,
  ArrowUpRight,
  BarChart3,
  HeartPulse,
  Megaphone,
  Settings2,
  Wallet,
} from 'lucide-react';

const cms = await fetchSiteContent('uz-Latn');
// Bosh sahifa matni — CMS'da 'hero.home.v2' (badge, title, subtitle, cta_primary).
// Sarlavhada "|" — qator bo'luvchi (ikkinchi qator o'ngga suriladi).
const hero = cms?.by_key['hero.home.v2'];
const seo = getSeoOverride(cms, '/');
const pub = await fetchPublicPlans();

const titleLines = getString(hero, 'title', 'Klinikangiz|bitta tizimda')
  .split('|')
  .map((s) => s.trim())
  .filter(Boolean)
  .slice(0, 2);
const heroSubtitle = getString(
  hero,
  'subtitle',
  "Qabulxona, navbat, kassa, laboratoriya, diagnostika, dorixona, statsionar, buxgalteriya va analitika — brauzerda, Windows va mobil ilovada. O'zbek tilida.",
);
const ctaPrimary = getString(hero, 'cta_primary', 'Bepul boshlash');

const groups = pub?.groups ?? FALLBACK_GROUPS;
const modules = pub?.modules ?? FALLBACK_MODULES;
const CORE = ['Qabulxona', 'Bemorlar bazasi', 'Navbat', 'Kassa va smena', 'Moliyaviy jurnal', 'Xodimlar va rollar'];
const plans = (pub?.plans ?? []).filter((p) => p.code !== 'demo');
const featuredIdx = plans.length >= 3 ? Math.floor(plans.length / 2) : -1;

const GROUP_META: Record<string, { title: string; icon: typeof Wallet; tags: string[] }> = {
  clinical: { title: 'Klinik', icon: HeartPulse, tags: ['Shifokor', 'Lab', 'Dorixona'] },
  operations: { title: 'Operatsiyalar', icon: Settings2, tags: ['Telefon', 'Filiallar'] },
  finance: { title: 'Moliya', icon: Wallet, tags: ['Buxgalteriya', 'Maosh'] },
  analytics: { title: 'Analitika', icon: BarChart3, tags: ['BI', 'AI'] },
  growth: { title: 'Marketing', icon: Megaphone, tags: ['Bot', 'Sayt'] },
};

const works = [
  {
    art: 'voice' as const,
    tags: ['Telefon', 'AI'],
    title: 'AI qabulxona',
    body: "Qo'ng'iroqqa tizim o'zi javob beradi, bo'sh vaqtni aytadi va bemorni navbatga yozadi. IP-telefoniya, stol telefonlari, brauzerdagi softfon.",
    href: '/features/ai',
  },
  {
    art: 'network' as const,
    tags: ['Tarmoq', '10 filial'],
    title: 'Filiallar tarmog‘i',
    body: "Asosiy klinika va 10 tagacha filial bitta markazda: dori va pul o'tkazmasi, yo'llanmalar, umumiy bemor bazasi, taqqoslovchi hisobot.",
    href: '/solutions/filiallar-tarmogi',
  },
  {
    art: 'pharmacy' as const,
    tags: ['Dorixona', 'MXIK'],
    title: 'Dorixona',
    body: "Soliq tasnifi (MXIK) bilan katalog, barkod, partiya va yaroqlilik muddati nazorati, qaytarish, qarzga sotuv, PIN bilan kassirlar.",
    href: '/solutions/dorixona-dasturi',
  },
  {
    art: 'lab' as const,
    tags: ['Laboratoriya', 'QR'],
    title: 'Natija QR’da',
    body: "Laborant natijani kiritadi — bemor chekdagi QR orqali telefonida ochadi. Yoshga qarab me'yorlar, mustaqil laboratoriya uchun savdo oynasi.",
    href: '/solutions/laboratoriya-dasturi',
  },
  {
    art: 'finance' as const,
    tags: ['Kassa', 'Buxgalteriya'],
    title: 'Kassadan P&L gacha',
    body: "Aralash to'lov, smena va seyf, inkasatsiya, qarzdorlar, oy yopish, balans, QQS, byudjet va maosh — har bir so'm izi bilan.",
    href: '/solutions/kassa-dasturi',
  },
  {
    art: 'analytics' as const,
    tags: ['Analitika', 'BI'],
    title: 'Aniq raqamlar',
    body: "Tushum haqiqatda kelgan pul bo'yicha: shifokor va xizmat reytingi, yuklama xaritasi, segmentlar, prognoz, hisobot quruvchi, Telegram hisobotlari.",
    href: '/solutions/analitika-dasturi',
  },
];

const platforms = [
  ['Veb-ilova', "Istalgan kompyuter va planshetda brauzer orqali — o'rnatish shart emas.", '/features'],
  ['Windows ilovasi', 'Chek, A4 va yorliqlarni oynasiz chop etish, termal printerlar.', '/download'],
  ['Mobil ilova', 'Shifokor va hamshira: maosh, xizmatlar, statsionar bemorlar, chaqiruvlar.', '/download'],
  ['Bemor portali', 'Onlayn navbat, natijalar, eslatmalar va Telegram bot.', '/patients'],
  ['TV navbat ekrani', 'Kutish zalidagi televizorda navbat va ovozli chaqiruv.', '/features'],
  ['Chekda QR', "Bemor chek va qarz holatini telefonida ko'radi.", '/features'],
];

const control = [
  'Rollar va 90+ ruxsat — har kim faqat o‘z ishini ko‘radi',
  'Maxsus rollar — o‘z ruxsatlar to‘plamingiz',
  'Qurilmalar nazorati — begona kompyuter bloklanadi',
  'Jurnal PIN-kodi — moliyaviy yozuv faqat PIN bilan o‘zgaradi',
  'Audit jurnali — kim, qachon, nimani o‘zgartirgani',
  'Savatcha — o‘chirilgan yozuv sabab bilan tiklanadi',
];

const faq = [
  {
    question: 'Qancha muddat bepul ishlatish mumkin?',
    answer:
      "Ro'yxatdan o'tganingizdan keyin 3 kunlik demo ochiladi. Shu vaqt ichida tarif tanlasangiz — 30 kun bepul sinov (bir marta). Bank kartasi so'ralmaydi.",
  },
  {
    question: "Kompyuterga biror narsa o'rnatish kerakmi?",
    answer:
      "Yo'q, Clary brauzerda ishlaydi. Chek printerlaridan oynasiz chop etish uchun Windows ilovasi, xodimlar uchun mobil ilova ham bor.",
  },
  {
    question: 'Bir nechta filialni boshqara olamanmi?',
    answer:
      "Ha. Bitta asosiy klinika va 10 tagacha filial bitta tarmoqqa ulanadi: umumiy hisobot, filiallararo transferlar va yo'llanmalar, umumiy bemor bazasi.",
  },
  {
    question: "Ma'lumotlarim qanday himoyalanadi?",
    answer:
      "Ma'lumotlar xalqaro bulut infratuzilmasida shifrlangan ulanish orqali saqlanadi, har bir klinika ma'lumoti boshqasidan qat'iy ajratilgan. Rollar, qurilmalar nazorati, audit jurnali va muntazam zaxira nusxalar mavjud.",
  },
  {
    question: "Tarifni o'zgartirsam ma'lumotlar yo'qolmaydimi?",
    answer:
      "Yo'qolmaydi. Biror modul tarifga kirmasa ham ma'lumot o'chirilmaydi — faqat bo'limga kirish yopiladi. Tarifni kengaytirsangiz hammasi joyida bo'ladi.",
  },
  {
    question: 'Qaysi tillarda ishlaydi?',
    answer: "O'zbek (lotin va kirill), rus va ingliz tillarida. Hujjatlar va cheklar o'zbek tilida.",
  },
];

const W = 'mx-auto max-w-[1440px] px-5 sm:px-10 lg:px-[90px]';
---
<Base
  variant="cinematic"
  overlayNav
  title={seo?.title ?? 'Clary — klinika boshqaruv tizimi | Healthcare ERP: qabulxona, kassa, laboratoriya, dorixona'}
  description={seo?.description ?? "Clary — klinika va shifoxonalar uchun yagona tizim: qabulxona, navbat, kassa, laboratoriya, diagnostika, dorixona, statsionar, buxgalteriya va analitika. AI ovozli qabulxona, 10 tagacha filial. 30 kun bepul sinov."}
  image={seo?.ogImage}
  faq={faq}
>
  <!-- ═══ HERO ════════════════════════════════════════════════════════════ -->
  <section class="relative flex min-h-[100svh] flex-col overflow-hidden">
    <!-- O'ngdagi monoxrom mahsulot ekrani (fotosurat o'rnida) -->
    <div
      class="pointer-events-none absolute inset-y-0 right-0 hidden w-[58%] lg:block"
      style="-webkit-mask-image:linear-gradient(90deg,transparent 0%,#000 40%,#000 82%,transparent 100%);mask-image:linear-gradient(90deg,transparent 0%,#000 40%,#000 82%,transparent 100%)"
      aria-hidden="true"
    >
      <div class="absolute right-[-4%] top-[14%] w-[760px] rotate-[-4deg] opacity-[0.5] grayscale" style="-webkit-mask-image:linear-gradient(180deg,#000 55%,transparent 100%);mask-image:linear-gradient(180deg,#000 55%,transparent 100%)">
        <div class="overflow-hidden rounded-[22px] border border-white/10 bg-[#18181b] shadow-2xl">
          <div class="flex items-center gap-1.5 border-b border-white/10 px-5 py-3">
            <span class="h-2.5 w-2.5 rounded-full bg-white/30"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-white/30"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-white/30"></span>
          </div>
          <div class="grid grid-cols-[150px_1fr] text-[13px] text-white/70">
            <div class="space-y-1 border-r border-white/10 p-3">
              {['Asosiy', 'Qabulxona', 'Navbat', 'Kassa', 'Laboratoriya', 'Dorixona', 'Statsionar', 'Analitika'].map((x, i) => (
                <div class={`rounded-md px-3 py-2 ${i === 0 ? 'bg-white/10 text-white' : ''}`}>{x}</div>
              ))}
            </div>
            <div class="space-y-4 p-5">
              <div class="grid grid-cols-3 gap-3">
                {['Tushum', 'Navbatda', 'Qabul'].map((l, i) => (
                  <div class="rounded-xl border border-white/10 p-3">
                    <div class="text-[11px] text-white/50">{l}</div>
                    <div class="mt-1 h-4 rounded bg-white/25" style={`width:${70 - i * 18}%`}></div>
                  </div>
                ))}
              </div>
              <div class="flex h-36 items-end gap-2 rounded-xl border border-white/10 p-4">
                {[40, 55, 48, 66, 52, 74, 69, 61, 79, 72, 86, 81, 92, 97].map((h) => (
                  <div class="flex-1 rounded-t bg-white/35" style={`height:${h}%`}></div>
                ))}
              </div>
              <div class="space-y-2">
                {[0, 1, 2, 3].map((i) => (
                  <div class="flex items-center gap-3 rounded-lg border border-white/10 px-3 py-2.5">
                    <span class="h-3 w-10 rounded bg-white/20"></span>
                    <span class="h-3 flex-1 rounded bg-white/15"></span>
                    <span class="h-5 w-16 rounded-full bg-white/25" style={`opacity:${1 - i * 0.2}`}></span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class={`${W} relative flex w-full flex-1 flex-col justify-end pb-10 pt-36 lg:pb-14 lg:pt-44`}>
      <h1 class="cin-display text-[16vw] sm:text-[clamp(64px,13.5vw,248px)]">
        {titleLines.map((line, i) => (
          <span class={`cin-line ${i === 1 ? 'lg:pl-[20%]' : ''}`}><span>{line}</span></span>
        ))}
      </h1>

      <div class="mt-10 grid gap-8 lg:mt-14 lg:grid-cols-[1fr_auto] lg:items-end">
        <div class="grid gap-6 text-[15px] font-bold leading-relaxed text-white sm:grid-cols-3" data-reveal>
          <p>Qabulxona · Kassa · Laboratoriya<br />Dorixona · Statsionar · Hisobot</p>
          <p>Toshkent, O'zbekiston<br /><span class="text-white/60">soat <span data-cin-clock>--:--</span></span></p>
          <p>Healthcare ERP &amp;<br />klinika boshqaruv tizimi</p>
        </div>
        <a href="#imkoniyatlar" class="relative hidden h-[140px] w-[140px] items-center justify-center lg:flex" aria-label="Pastga" data-magnetic>
          <svg class="cin-spin absolute inset-0" viewBox="0 0 140 140" aria-hidden="true">
            <defs><path id="cin-circ" d="M70,70 m-56,0 a56,56 0 1,1 112,0 a56,56 0 1,1 -112,0" /></defs>
            <text font-size="11.5" font-weight="700" letter-spacing="2.6" fill="#fff" font-family="Roboto Mono, monospace">
              <textPath href="#cin-circ">CLARY · HEALTHCARE ERP · PASTGA · </textPath>
            </text>
          </svg>
          <ArrowDownRight className="h-6 w-6 text-white" />
        </a>
      </div>

      <div class="mt-10 flex flex-col gap-4 border-t border-white/10 pt-8 lg:flex-row lg:items-center lg:justify-between" data-reveal data-reveal-delay="1">
        <p class="max-w-2xl text-sm leading-relaxed text-white/70">{heroSubtitle}</p>
        <div class="flex flex-wrap gap-3">
          <a href="/signup" class="cin-btn cin-btn--solid" data-magnetic>{ctaPrimary} <ArrowUpRight className="h-4 w-4" /></a>
          <a href="/book-demo" class="cin-btn cin-btn--line" data-magnetic>Jonli namoyish</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ IMKONIYATLAR (ish kartalari) ════════════════════════════════════ -->
  <Marquee id="imkoniyatlar" text="Imkoniyatlar" />
  <section class={`${W} space-y-16 pb-10 lg:space-y-24`}>
    {works.map((w, i) => (
      <article class={`relative w-full lg:w-[58%] ${i % 2 === 1 ? 'lg:ml-auto' : ''}`} data-reveal>
        <a href={w.href} class="cin-card group block aspect-[3/4] sm:aspect-[3/2]" data-cursor-big>
          <div class="cin-card__art"><CinArt kind={w.art} /></div>
          <div class="cin-card__shade"></div>
          <div class="relative z-10 flex h-full flex-col justify-between p-5 sm:p-7">
            <div class="flex flex-wrap gap-2">
              {w.tags.map((t) => <span class="cin-pill">{t}</span>)}
            </div>
            <div class="flex items-end justify-between gap-4">
              <div>
                <h3 class="cin-display cin-card__title text-[clamp(44px,6.2vw,92px)]">{w.title}</h3>
                <p class="mt-3 hidden max-w-lg text-[13px] leading-relaxed text-white/75 sm:block">{w.body}</p>
              </div>
              <ArrowUpRight className="cin-card__arrow h-9 w-9 shrink-0 text-white" />
            </div>
          </div>
        </a>
        <p class="mt-4 text-[13px] leading-relaxed text-white/70 sm:hidden">{w.body}</p>
      </article>
    ))}
  </section>
  <div class="flex justify-center py-16 lg:pt-28">
    <a href="/features" class="cin-circle" data-magnetic>Barcha<br />imkoniyatlar <ArrowUpRight className="h-4 w-4" /></a>
  </div>

  <!-- ═══ MODULLAR (xizmatlar ro'yxati uslubida) ═══════════════════════════ -->
  <Marquee text="Modullar" reverse speed={44} />
  <section class={`${W} pb-10`}>
    <div class="mb-10 flex flex-wrap items-center gap-2" data-reveal>
      <span class="cin-label mr-2 text-white/50">Har bir tarifda:</span>
      {CORE.map((c) => <span class="cin-pill cin-pill--ghost">{c}</span>)}
    </div>
    {groups.map((g) => {
      const list = modules.filter((m) => m.group === g.key);
      const meta = GROUP_META[g.key] ?? { title: g.label, icon: Settings2, tags: [] };
      const Icon = meta.icon;
      return list.length === 0 ? null : (
        <div class="grid gap-8 border-b border-white/10 py-12 lg:grid-cols-2 lg:gap-16" data-reveal>
          <div class="flex gap-6">
            <span class="flex h-[100px] w-[100px] shrink-0 items-center justify-center rounded-full border border-white/15">
              <Icon className="h-8 w-8 text-white" />
            </span>
            <div>
              <h3 class="cin-display text-[clamp(52px,6.5vw,96px)] !text-white">{meta.title}</h3>
              <div class="mt-4 flex flex-wrap gap-2">
                <span class="cin-pill">{list.length} modul</span>
                {meta.tags.map((t) => <span class="cin-pill">{t}</span>)}
              </div>
            </div>
          </div>
          <ul class="divide-y divide-white/10">
            {list.map((m) => (
              <li class="group flex items-center gap-4 py-4 first:pt-0">
                <ModuleIcon name={m.key} className="h-4 w-4 shrink-0 text-white/40 transition group-hover:text-[var(--cin-cream)]" />
                <span class="text-[17px] text-white/75 transition group-hover:text-white">{m.label}</span>
                <span class="ml-auto hidden text-right text-xs text-white/40 md:block">{m.description}</span>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </section>

  <!-- ═══ PLATFORMALAR (boy ro'yxat) ═══════════════════════════════════════ -->
  <Marquee text="Platformalar" speed={34} />
  <section class={`${W} pb-10`}>
    <ul class="border-t border-white/10">
      {platforms.map(([t, b, href], i) => (
        <li data-reveal>
          <a href={href} class="group grid items-center gap-3 border-b border-white/10 py-7 sm:grid-cols-[80px_1fr_1.1fr_40px] sm:gap-8" data-cursor>
            <span class="cin-label text-white/40">0{i + 1}</span>
            <span class="cin-display text-[clamp(40px,5vw,76px)] transition-transform duration-500 group-hover:translate-x-3">{t}</span>
            <span class="text-sm leading-relaxed text-white/65">{b}</span>
            <ArrowUpRight className="hidden h-7 w-7 text-white/60 transition group-hover:text-white sm:block" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ═══ NAZORAT ═════════════════════════════════════════════════════════ -->
  <Marquee text="Nazorat" reverse speed={40} />
  <section class={`${W} pb-10`}>
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <p class="cin-display text-[clamp(44px,5.4vw,84px)] !text-white">Pul va ma'lumot — to'liq nazoratingizda</p>
        <p class="mt-6 max-w-lg text-sm leading-relaxed text-white/65">
          Har bir xodim faqat o'z bo'limini ko'radi, har bir o'zgarish iz qoldiradi. Integratsiyalar: Click, Payme, Uzum, Humo, Uzcard, Telegram, Uztelecom IP-telefoniya, soliq MXIK katalogi.
        </p>
      </div>
      <ul class="divide-y divide-white/10 border-y border-white/10" data-reveal data-reveal-delay="1">
        {control.map((c) => (
          <li class="flex items-center gap-4 py-5 text-[16px] text-white/80">
            <span class="text-[var(--cin-cream)]">✳</span> {c}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ TARIFLAR ════════════════════════════════════════════════════════ -->
  <Marquee text="Tariflar" speed={36} />
  <section class={`${W} pb-10`}>
    {plans.length > 0 ? (
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {plans.map((p, i) => {
          const hot = i === featuredIdx;
          return (
            <div class={`flex flex-col rounded-[18px] p-7 ${hot ? 'bg-[var(--cin-cream)] text-[#111]' : 'bg-[var(--cin-card)] text-white'}`} data-reveal data-reveal-delay={String(i % 3)}>
              <span class={`cin-label ${hot ? 'text-black/60' : 'text-white/50'}`}>{p.limits.max_staff ?? '∞'} xodim · {p.limits.max_devices ?? '∞'} qurilma</span>
              <h3 class={`cin-display mt-4 text-[clamp(48px,5vw,72px)] ${hot ? '!text-[#111]' : '!text-white'}`}>{p.name}</h3>
              {p.description && <p class="mt-2 text-sm opacity-70">{p.description}</p>}
              <div class="mt-6 text-3xl font-bold">{fmtUzs(p.price_uzs)} <span class="text-sm font-normal opacity-60">so'm/oy</span></div>
              <ul class="mt-6 flex-1 space-y-2 text-sm opacity-80">
                <li>✳ {p.modules.length + CORE.length} modul</li>
                {p.highlights.slice(0, 5).map((h) => <li>✳ {h}</li>)}
              </ul>
              <a href={`/signup?plan=${p.code}`} class={`cin-btn mt-8 ${hot ? 'bg-[#111] text-white hover:bg-black' : 'cin-btn--solid'}`}>30 kun bepul <ArrowUpRight className="h-4 w-4" /></a>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="flex flex-col items-start justify-between gap-6 rounded-[18px] bg-[var(--cin-card)] p-8 lg:flex-row lg:items-center" data-reveal>
        <p class="cin-display text-[clamp(40px,4.6vw,68px)] !text-white">Hajmingizga mos tarif</p>
        <a href="/pricing" class="cin-btn cin-btn--solid">Tariflarni ko'rish <ArrowUpRight className="h-4 w-4" /></a>
      </div>
    )}
    <p class="mt-6 text-center text-xs text-white/50">3 kunlik demo · tarif tanlasangiz 30 kun bepul · karta so'ralmaydi · <a href="/pricing" class="underline hover:text-white">batafsil taqqoslash</a></p>
  </section>

  <!-- ═══ SAVOLLAR ════════════════════════════════════════════════════════ -->
  <Marquee text="Savollar" reverse speed={42} />
  <section class={`${W} pb-10`}>
    <div class="border-t border-white/10">
      {faq.map((f) => (
        <details class="group border-b border-white/10" data-reveal>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-7 text-[17px] font-bold text-white sm:text-[19px]">
            <span>{f.question}</span>
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/20 text-xl transition group-open:rotate-45">+</span>
          </summary>
          <p class="max-w-3xl pb-7 text-sm leading-relaxed text-white/65">{f.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ═══ ALOQA ═══════════════════════════════════════════════════════════ -->
  <Marquee text="Aloqa" speed={34} />
  <section class={`${W} pb-24`}>
    <div class="grid gap-12 lg:grid-cols-2">
      <div class="divide-y divide-white/10" data-reveal>
        {[
          ['E-mail', 'clarysupport@gmail.com', 'mailto:clarysupport@gmail.com'],
          ['Ilova', 'app.clary.uz', 'https://app.clary.uz/login'],
          ['Sinov', '3 kun demo + 30 kun bepul', '/signup'],
          ['Ofis', "Toshkent, O'zbekiston", '/contact'],
        ].map(([l, v, href]) => (
          <a href={href} class="grid grid-cols-[110px_1fr] gap-4 py-6 first:pt-0 sm:grid-cols-[1fr_1.4fr]">
            <span class="cin-label pt-1.5 text-white">{l}</span>
            <span class="text-lg font-bold text-white transition hover:text-[var(--cin-cream)] sm:text-[22px]">{v}</span>
          </a>
        ))}
      </div>
      <form id="cin-demo-form" class="rounded-[18px] bg-[var(--cin-card-2)] p-7 sm:p-12" data-reveal data-reveal-delay="1">
        <p class="cin-label mb-6 text-white/60">Namoyishga yozilish — tez orada bog'lanamiz</p>
        <div class="grid gap-6 sm:grid-cols-2">
          <input class="cin-field" name="fullName" placeholder="Ismingiz" required minlength="2" autocomplete="name" />
          <input class="cin-field" name="phone" placeholder="Telefon" required autocomplete="tel" inputmode="tel" />
        </div>
        <input class="cin-field mt-6" name="clinicName" placeholder="Klinika nomi" autocomplete="organization" />
        <textarea class="cin-field mt-6 min-h-[120px] resize-none" name="message" placeholder="Klinikangiz haqida (bo'limlar, xodimlar soni)"></textarea>
        <button type="submit" class="cin-btn cin-btn--solid mt-8 w-full" data-magnetic>Yuborish <ArrowUpRight className="h-4 w-4" /></button>
        <p class="mt-4 hidden text-sm" data-cin-form-status></p>
      </form>
    </div>
  </section>
</Base>

<script>
  // Namoyish so'rovi — /api/v1/public/demo-request (book-demo bilan bir xil yo'l)
  const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? 'https://api.clary.uz';
  const form = document.getElementById('cin-demo-form') as HTMLFormElement | null;
  const status = form?.querySelector<HTMLElement>('[data-cin-form-status]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const body: Record<string, unknown> = Object.fromEntries(fd);
    body.turnstileToken = 'dev-skip';
    const btn = form.querySelector('button');
    if (btn) btn.disabled = true;
    const show = (text: string, ok: boolean) => {
      if (!status) return;
      status.textContent = text;
      status.classList.remove('hidden');
      status.style.color = ok ? '#86efac' : '#fca5a5';
    };
    try {
      const res = await fetch(`${apiBase}/api/v1/public/demo-request`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (res.ok) {
        show("Rahmat! Tez orada bog'lanamiz.", true);
        form.reset();
      } else {
        let detail = '';
        try {
          const j = await res.json();
          detail = j?.error?.message ?? j?.message ?? '';
        } catch {
          /* bo'sh */
        }
        show(detail ? `Xatolik: ${detail}` : `Xatolik (${res.status}). clarysupport@gmail.com ga yozing.`, false);
      }
    } catch {
      show("Internet aloqasi yo'q. clarysupport@gmail.com ga yozing.", false);
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>
