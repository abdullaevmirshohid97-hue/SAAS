{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clary",
  "version": "0.2.0",
  "identifier": "uz.clary.desktop",
  "build": {
    "frontendDist": "shell",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter web-clinic dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clary — Klinika boshqaruvi",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://app.clary.uz; object-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.clary.uz https://*.supabase.co wss://*.supabase.co https://*.posthog.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/SumatraPDF.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://clary.uz/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdERkYwNDk0REMyNUU2RUEKUldUcTVpWGNsQVQvZmJvTHIzRnZmYnB1M2tteldIRGNlM0pTa3dQZjAxaWNCK0hhY24vb0dzeGwK"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "clary"
        ]
      }
    }
  }
}
