:4321 {
  root * /srv
  file_server
  encode zstd gzip

  # Statik Astro sayti — SPA fallback'i yo'q (soft-404 sababi edi).
  # Asosiy Caddyfile'dagi clary.uz bloki bilan bir xil xatti-harakat.
  try_files {path} {path}/

  handle_errors {
    rewrite * /404.html
    file_server {
      status {err.status_code}
    }
  }
}
